<?xml version="1.0"?>
<!--bin_to_xml settings.
	title
		Set title for correct archive handling.
	platform
		Set platform for correct archive handling.
		Values: Auto, Win32, PS3, X360, N3DS, CAFE, NSW, PS4, Android, IOS, Win64, 
-->
<bin_to_xml
	title=""
	platform="Auto" />
<!--ddon_sngw settings.
	encrypt
		Switch between encrypt or decrypt only.
-->
<ddon_sngw
	encrypt="false" />
<!--extract_arc settings.
	title
		Set title for correct archive handling.
	platform
		Set platform for correct archive handling.
		Values: Auto, Win32, PS3, X360, N3DS, CAFE, NSW, PS4, Android, IOS, Win64, 
	class-whitelist
		Extract only specified (comma separated) classes. Extract all if empty.
-->
<extract_arc
	title=""
	platform="Auto"
	class-whitelist="" />
<!--make_arc settings.
	title
		Set title for correct archive handling.
	platform
		Set platform for correct archive handling.
		Values: Auto, Win32, PS3, X360, N3DS, CAFE, NSW, PS4, Android, IOS, Win64, 
-->
<make_arc
	title=""
	platform="Auto" />
<!--mtf_tex_to_dds settings.
	platform
		Set platform for correct texture handling.
		Values: Auto, Win32, PS3, X360, N3DS, CAFE, NSW, PS4, Android, IOS, Win64, 
-->
<mtf_tex_to_dds
	platform="Auto" />
<!--re_tex_to_dds settings.
	legacy-dds
		Tries to convert texture into legacy (DX9) DDS format.
	force-legacy-dds
		Will try to convert some matching formats from DX10 to DX9, for example: RG88 to AL88.
	largest-mipmap-only
		Will try to extract only highest mipmap.
-->
<re_tex_to_dds
	legacy-dds="true"
	force-legacy-dds="false"
	largest-mipmap-only="true" />
<!--xfs_to_xml settings.
	save-rtti
		Save layout information.
	save-data
		Save data.
-->
<xfs_to_xml
	save-rtti="true"
	save-data="true" />
<!--xml_to_bin settings.
	title
		Set title for correct archive handling.
	platform
		Set platform for correct archive handling.
		Values: Auto, Win32, PS3, X360, N3DS, CAFE, NSW, PS4, Android, IOS, Win64, 
-->
<xml_to_bin
	title=""
	platform="Auto" />
<!--mod_to_gltf settings.
	quantize-mesh
		Apply KHR_mesh_quantization.
	quantize-mesh-fake
		KHR_mesh_quantization is not marked as required extension.
	no-lods
		Do not export LOD meshes.
	merge-meshes
		Merge meshes as groups
	generate-model-info
		Generate model info xml alongside gltf.
-->
<mod_to_gltf
	quantize-mesh="true"
	quantize-mesh-fake="false"
	no-lods="true"
	merge-meshes="true"
	generate-model-info="false" />
<!--common settings.
	generate-log
		Will generate text log of console output inside application location.
	verbosity
		Prints more information per level.
	extract-settings
		folder-per-archive
			When extracting, create folder that uses input archive's name as output dir.
		create-zip
			Pack extracted files inside ZIP file named after input archive. Your HDD will thank you.
	compress-settings
		ratio-threshold
			Writes compressed data only when compression ratio is less than specified threshold [0 - 100]%
		min-file-size
			Files that are smaller than specified size won't be compressed.
	texel-settings
		output-format
			Specify output format for images
			Values: 
				DDS_Legacy:
					Use legacy dds container but decode to uncompressed formats if necessary
					Supported legacy formats:
					  BC1, BC2, BC3, Grayscale, RGB8, RGBA8, RGB565, RGBA4
					Other formats will be converted to 8bit channeled format like:
					  BC4 -> Grayscale
					  BC5 -> RGX8
					  BC7 -> RGBA8 or RGB8
					Support for mipmaps, cubemaps, volumetrics

				DDS:
					dds, data format is unchanged
					PVRTC and ETC will be converted to RGBA8

				QOI_BMP:
					Decode to Quite OK Image format.
					Only for RGX, RGB and RGBA
					2 channels will be converted to RGX8
					Decode to BMP for P8, P4, Grayscale,

				QOI:
					Decode to Quite OK Image format.
					Normal formats RGB and RGBA are kept instact
					2 channels will be converted to RGX8
					8bit (P8) and 4bit (P4) palletes will be expanded to RGB or RGBA
					Grayscale will be expanded to RGB

		single-cube
			Convert cubemaps into equirectangular layout
		process-mipmaps
			Save only largest mipmap for each mipmap chain
	<-tag: titles->
	Valid titles: title ( supported platforms )
		sengoku_basara_sanada_yukimura_den (PS3, PS4)
		ace_attorney_spirit_of_justice (N3DS)
		sengoku_basara_samurai_heroes (PS3)
		ace_attorney_dual_destinies (N3DS)
		monster_hunter_double_cross (N3DS, NSW)
		resident_evil_code_veronica (PS3)
		ultimate_marvel_vs_capcom_3 (PS3, Win64)
		monster_hunter_generations (N3DS, NSW)
		resident_evil_mercenaries (N3DS)
		resident_evil_revelations (Win32, N3DS)
		sengoku_basara_4_sumeragi (PS3)
		monster_hunter_stories_2 (NSW)
		monster_hunter_explore (Android)
		monster_hunter_stories (N3DS, PS4, Android, IOS)
		dai_gyakuten_saiban_2 (N3DS)
		dragons_dogma_online (Win32)
		monster_hunter_cross (N3DS, NSW)
		dai_gyakuten_saiban (N3DS)
		monster_hunter_xx (N3DS, NSW)
		monster_hunter_3 (N3DS, CAFE)
		monster_hunter_4 (N3DS)
		monster_hunter_x (N3DS, NSW)
		sengoku_basara_3 (PS3)
		sengoku_basara_4 (PS3)
		devil_may_cry_4 (Win32, PS3)
		resident_evil_0 (Win32)
		resident_evil_5 (Win32, PS4)
		resident_evil_6 (Win32, PS3)
		dragons_dogma (Win32, PS3)
		lost_planet_2 (Win32, PS3)
		biohazard_0 (Win32)
		biohazard_5 (Win32, PS4)
		biohazard_6 (Win32, PS3)
		dead_rising (X360, Win64)
		ex_troopers (PS3)
		lost_planet (Win32, PS3)
		pwaasoj (N3DS)
		pwaadd (N3DS)
		sbsyd (PS3, PS4)
		umvc3 (PS3, Win64)
		ddon (Win32)
		dgs2 (N3DS)
		dmc4 (Win32, PS3)
		mhs2 (NSW)
		mhxr (Android)
		mhxx (N3DS, NSW)
		recv (PS3)
		sb4s (PS3)
		sbsh (PS3)
		dgs (N3DS)
		ext (PS3)
		lp2 (Win32, PS3)
		mh3 (N3DS, CAFE)
		mh4 (N3DS)
		mhg (N3DS, NSW)
		mhs (N3DS, PS4, Android, IOS)
		mhx (N3DS, NSW)
		re0 (Win32)
		re5 (Win32, PS4)
		re6 (Win32, PS3)
		rem (N3DS)
		rer (Win32, N3DS)
		sb3 (PS3)
		sb4 (PS3)
		dd (Win32, PS3)
		dr (X360, Win64)
		lp (Win32, PS3)
-->
<common
	generate-log="false"
	verbosity="0">
	<extract-settings
		folder-per-archive="true"
		create-zip="true" />
	<compress-settings
		ratio-threshold="90"
		min-file-size="128" />
	<texel-settings
		output-format="DDS_Legacy"
		single-cube="true"
		process-mipmaps="false" />
</common>
